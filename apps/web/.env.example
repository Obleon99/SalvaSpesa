# Facoltativo: prezzi Amazon nel tracker (Creators API di Amazon, programma Affiliazione Amazon).
# Copia questo file in .env.local e compila i valori che trovi in Affiliazione Amazon > Strumenti > Creators API.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_TOKEN_URL=
AMAZON_PARTNER_TAG=
# Solo se Amazon indica un indirizzo diverso da quello predefinito:
# AMAZON_CREATORS_API_BASE=https://creatorsapi.amazon/catalog/v1
